{
  "$defs": {
    "AgentMode": {
      "enum": [
        "RESEARCH",
        "SIM",
        "PAPER",
        "LIVE"
      ],
      "title": "AgentMode",
      "type": "string"
    },
    "Basis": {
      "description": "What evidence a metric was computed on.",
      "enum": [
        "IN_SAMPLE",
        "OUT_OF_SAMPLE",
        "WALK_FORWARD",
        "MONTE_CARLO",
        "SIMULATION",
        "PAPER",
        "LIVE"
      ],
      "title": "Basis",
      "type": "string"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "kind": {
          "enum": [
            "MARKET_DATA",
            "BROKER",
            "RESEARCH_BUS",
            "MEMORY",
            "OTHER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "last_heartbeat": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Heartbeat"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ConnectionState"
        }
      },
      "required": [
        "name",
        "kind",
        "state"
      ],
      "title": "Connection",
      "type": "object"
    },
    "ConnectionState": {
      "enum": [
        "CONNECTED",
        "DEGRADED",
        "DISCONNECTED",
        "NOT_CONFIGURED"
      ],
      "title": "ConnectionState",
      "type": "string"
    },
    "DocumentMeta": {
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "producer",
        "generated_at",
        "origin"
      ],
      "title": "DocumentMeta",
      "type": "object"
    },
    "ExecutionState": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "connections": {
          "items": {
            "$ref": "#/$defs/Connection"
          },
          "title": "Connections",
          "type": "array"
        },
        "fills": {
          "items": {
            "$ref": "#/$defs/Trade"
          },
          "title": "Fills",
          "type": "array"
        },
        "open_orders": {
          "items": {
            "$ref": "#/$defs/Order"
          },
          "title": "Open Orders",
          "type": "array"
        },
        "stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionStats"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "as_of"
      ],
      "title": "ExecutionState",
      "type": "object"
    },
    "ExecutionStats": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "fills": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fills"
        },
        "latency_ms_p50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms P50"
        },
        "latency_ms_p95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms P95"
        },
        "rejects": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejects"
        },
        "slippage_bps_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slippage Bps Mean"
        },
        "slippage_model_bps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slippage Model Bps"
        }
      },
      "required": [
        "as_of"
      ],
      "title": "ExecutionStats",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A single reported number with its basis and provenance.",
      "properties": {
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "component": {
          "anyOf": [
            {
              "enum": [
                "GROSS",
                "COST",
                "NET"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component"
        },
        "cost_multiplier": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Multiplier"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "unit": {
          "enum": [
            "ratio",
            "pct",
            "bps",
            "count",
            "currency",
            "contracts",
            "ms",
            "days",
            "years"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "window_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window End"
        },
        "window_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Start"
        }
      },
      "required": [
        "value",
        "unit",
        "basis"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Order": {
      "additionalProperties": false,
      "properties": {
        "agent_slot": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Slot"
        },
        "instrument": {
          "title": "Instrument",
          "type": "string"
        },
        "limit_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Price"
        },
        "mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "order_type": {
          "enum": [
            "MARKET",
            "LIMIT",
            "STOP",
            "STOP_LIMIT",
            "OTHER"
          ],
          "title": "Order Type",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "number"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ],
          "title": "Side",
          "type": "string"
        },
        "status": {
          "enum": [
            "WORKING",
            "PARTIAL",
            "FILLED",
            "CANCELLED",
            "REJECTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "instrument",
        "side",
        "quantity",
        "order_type",
        "status",
        "mode",
        "submitted_at"
      ],
      "title": "Order",
      "type": "object"
    },
    "Origin": {
      "description": "Where a record came from. Never merge counts across origins.",
      "enum": [
        "ORIGINAL",
        "RECONSTRUCTED",
        "SYNTHETIC_FIXTURE"
      ],
      "title": "Origin",
      "type": "string"
    },
    "Trade": {
      "additionalProperties": false,
      "properties": {
        "agent_slot": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Slot"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        },
        "instrument": {
          "title": "Instrument",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "pnl": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "price": {
          "title": "Price",
          "type": "number"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "number"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ],
          "title": "Side",
          "type": "string"
        },
        "slippage_bps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slippage Bps"
        },
        "trade_id": {
          "title": "Trade Id",
          "type": "string"
        }
      },
      "required": [
        "trade_id",
        "instrument",
        "side",
        "quantity",
        "price",
        "executed_at",
        "mode"
      ],
      "title": "Trade",
      "type": "object"
    }
  },
  "$id": "sentry-command-centre/v1/execution.schema.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/ExecutionState"
    },
    "meta": {
      "$ref": "#/$defs/DocumentMeta"
    }
  },
  "required": [
    "meta",
    "data"
  ],
  "title": "ExecutionStateDocument",
  "type": "object"
}

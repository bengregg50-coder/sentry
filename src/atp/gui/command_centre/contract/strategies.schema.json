          "title": "Strategies",
          "type": "array"
        }
      },
      "title": "StrategiesState",
      "type": "object"
    },
    "Strategy": {
      "additionalProperties": false,
      "properties": {
        "assigned_agent": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,

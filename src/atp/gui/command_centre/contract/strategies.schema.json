        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "global_trials_at_decision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Global Trials At Decision"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "state": {
          "$ref": "#/$defs/CheckState"
        },
        "trials_in_family": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trials In Family"
        }
      },
      "required": [
        "state"
      ],
      "title": "MultipleTesting",
      "type": "object"
    },
    "NamedMetric": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "key",
        "label",
        "metric"
      ],
      "title": "NamedMetric",
      "type": "object"
    },
    "Origin": {
      "description": "Where a record came from. Never merge counts across origins.",

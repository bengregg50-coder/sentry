        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/Window"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "regime"
      ],
      "title": "RegimeResult",
      "type": "object"
    },
    "Stage": {
      "description": "The research \u2192 deployment pipeline, in order.",
      "enum": [
        "DISCOVERY",
        "HYPOTHESIS",
        "BACKTEST",
        "ROBUSTNESS",
        "OOS",
        "VALIDATION",
        "APPROVED",
        "SIM",
        "LIVE",
        "SCALED"

        },
        "ref": {
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "LineageRef",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A single reported number with its basis and provenance.",
      "properties": {
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "component": {
          "anyOf": [
            {
              "enum": [
                "GROSS",
                "COST",
                "NET"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component"
        },
        "cost_multiplier": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Multiplier"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "unit": {
          "enum": [
            "ratio",
            "pct",
            "bps",
            "count",
            "currency",
            "contracts",
            "ms",
            "days",
            "years"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "window_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window End"
        },
        "window_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Start"
        }
      },
      "required": [
        "value",
        "unit",
        "basis"
      ],
      "title": "Metric",
      "type": "object"
    },
    "MultipleTesting": {
      "additionalProperties": false,
      "properties": {
        "adjusted_threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,

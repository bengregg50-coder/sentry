{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decided_by": {
          "title": "Decided By",
          "type": "string"
        },
        "decision": {
          "enum": [
            "APPROVED",
            "REJECTED",
            "REVOKED"
          ],
          "title": "Decision",
          "type": "string"
        },
        "decision_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Ref"
        },
        "scope": {
          "enum": [
            "SIM",
            "PAPER",
            "LIVE_SMALL",
            "LIVE"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "scope",
        "decided_at",
        "decided_by"
      ],
      "title": "Approval",
      "type": "object"
    },
    "Basis": {
      "description": "What evidence a metric was computed on.",
      "enum": [
        "IN_SAMPLE",
        "OUT_OF_SAMPLE",
        "WALK_FORWARD",
        "MONTE_CARLO",
        "SIMULATION",
        "PAPER",
        "LIVE"
      ],
      "title": "Basis",
      "type": "string"
    },
    "Check": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/CheckState"
        }
      },
      "required": [
        "state"
      ],
      "title": "Check",
      "type": "object"
    },
    "CheckState": {
      "enum": [
        "PASS",
        "FAIL",
        "PENDING",
        "NOT_RUN",
        "BLOCKED",
        "INCONCLUSIVE",
        "NOT_APPLICABLE"
      ],
      "title": "CheckState",
      "type": "string"
    },
    "DeploymentPackage": {
      "additionalProperties": false,
      "properties": {
        "cost_model_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Model Identity"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "data_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Identity"
        },
        "executor_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executor Identity"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "package_id": {
          "title": "Package Id",
          "type": "string"
        },
        "risk_limits_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Limits Ref"
        },
        "spec_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spec Hash"
        }
      },
      "required": [
        "package_id",
        "created_at"
      ],
      "title": "DeploymentPackage",
      "type": "object"
    },
    "DocumentMeta": {
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "heartbeat_max_age_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heartbeat Max Age S"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "producer",
        "generated_at",
        "origin"
      ],
      "title": "DocumentMeta",
      "type": "object"
    },
    "ImprovementProposal": {
      "additionalProperties": false,
      "description": "A proposed change. It can only ever become a *new* strategy version.",
      "properties": {
        "agent_slot": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Slot"
        },
        "base_version": {
          "minimum": 1,
          "title": "Base Version",
          "type": "integer"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "proposed_at": {
          "format": "date-time",
          "title": "Proposed At",
          "type": "string"
        },
        "proposed_by": {
          "title": "Proposed By",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "resulting_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resulting Version"
        },
        "state": {
          "$ref": "#/$defs/ProposalState"
        },
        "strategy_id": {
          "title": "Strategy Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "proposed_at",
        "proposed_by",
        "strategy_id",
        "base_version",
        "summary",
        "state"
      ],
      "title": "ImprovementProposal",
      "type": "object"
    },
    "LineageRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "PROGRAMME",
            "HYPOTHESIS",
            "TRIAL",
            "STRATEGY_VERSION",
            "MEMORY",
            "PROPOSAL",
            "DOCUMENT",
            "LITERATURE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,

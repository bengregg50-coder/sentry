        "mechanism": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mechanism"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "stage_reached": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
